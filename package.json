{
  "name": "tinfoil-design",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/http.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/routes.mjs",
    "postbuild": "node scripts/verify-printful.mjs 18898875 --if-configured",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/assets.mjs",
    "catalog:sync": "node --env-file-if-exists=.env scripts/sync-printful.mjs",
    "printful:verify": "node scripts/verify-printful.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "pg": "^8.13.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
